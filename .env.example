# Application settings
CLINIC_APP_NAME=Clinic Appointment Booking API
CLINIC_APP_ENV=development
CLINIC_DEBUG=true
CLINIC_HOST=0.0.0.0
CLINIC_PORT=8000

# PostgreSQL connection. Replace the sample username and password locally.
CLINIC_DATABASE_URL=postgresql+psycopg://clinic_user:clinic_password@localhost:5432/clinic_booking
